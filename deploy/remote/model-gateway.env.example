# Optional server-side model configuration for supabase functions serve.
# Copy this file to ~/service/jobflow-browser-extension/model-gateway.env,
# set values on the server, and keep the file mode at 0600.
# Never commit the populated file or use these values in the browser build.

MANAGED_MODEL_ENDPOINT=
MANAGED_MODEL_PROVIDER=
MANAGED_MODEL_NAME=
MANAGED_MODEL_API_KEY=
