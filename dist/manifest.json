{
  "manifest_version": 3,
  "name": "JobFlow 猎聘草稿助手",
  "version": "0.2.0",
  "description": "读取猎聘公开页面、生成草稿，并支持管理台逐条确认投递",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.liepin.com/*",
    "http://127.0.0.1:54321/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.liepin.com/*"
      ],
      "js": [
        "content/liepin.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "打开 JobFlow"
  }
}