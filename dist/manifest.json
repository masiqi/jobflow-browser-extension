{
  "manifest_version": 3,
  "name": "JobFlow 猎聘草稿助手",
  "version": "0.2.0",
  "description": "读取猎聘公开页面并生成可审核草稿；不会发送或投递",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.liepin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.liepin.com/*"
      ],
      "js": [
        "content/liepin.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "打开 JobFlow"
  }
}