{
  "manifest_version": 3,
  "name": "JobFlow 求职草稿助手",
  "version": "0.2.0",
  "description": "读取招聘网站公开页面并生成可审核的求职草稿",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.liepin.com/*",
    "https://www.zhaopin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.liepin.com/*"
      ],
      "js": [
        "content/liepin.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.zhaopin.com/*"
      ],
      "js": [
        "content/zhaopin-main.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.zhaopin.com/*"
      ],
      "js": [
        "content/zhaopin.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "打开 JobFlow"
  }
}