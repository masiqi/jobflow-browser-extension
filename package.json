{
  "name": "jobflow-browser-extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "带 Supabase 账号与可审核草稿的猎聘 Chrome MV3 助手",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "verify": "npm run typecheck && npm run build && npm test",
    "test:db": "supabase test db",
    "test:edge": "node scripts/test-supabase-integration.mjs",
    "verify:full": "npm run verify && npm run test:db",
    "smoke:extension": "node scripts/smoke-extension.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.1.1",
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.2.108",
    "typescript": "^5.8.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "lucide": "^1.44.0",
    "mammoth": "^1.12.2",
    "zod": "^4.6.1"
  }
}
